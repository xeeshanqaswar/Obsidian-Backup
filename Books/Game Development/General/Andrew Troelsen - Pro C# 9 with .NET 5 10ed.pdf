         <xmpMM:History>
            <rdf:Seq>
               <rdf:li rdf:parseType="Resource">
                  <stEvt:action>converted</stEvt:action>
                  <stEvt:instanceID>uuid:3ca91e16-7997-4420-853c-62b3f28a0f47</stEvt:instanceID>
