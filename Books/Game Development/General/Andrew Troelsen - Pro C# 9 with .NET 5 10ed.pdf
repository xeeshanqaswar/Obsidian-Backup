         <xmpMM:DocumentID>uuid:c3ea217a-6c9b-4f54-a29c-308c5d986128</xmpMM:DocumentID>
         <xmpMM:InstanceID>uuid:5f13d4e2-ec1f-4ef5-a25f-5647ca194d1b</xmpMM:InstanceID>
         <xmpMM:RenditionClass>default</xmpMM:RenditionClass>
